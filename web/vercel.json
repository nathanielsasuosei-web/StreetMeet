{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://natthesisa-api.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://natthesisa-api.onrender.com/socket.io"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://natthesisa-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
