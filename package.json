{
  "name": "streetmeet",
  "version": "2.0.0",
  "private": true,
  "description": "StreetMeet - dating app monorepo (Express API + React web client)",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix website install && npm run db:setup",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix website run dev",
    "build": "npm --prefix website run build",
    "start": "npm --prefix backend start",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:reset": "npm --prefix backend run db:reset",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm --prefix backend run db:setup",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "npm --prefix backend run smoke",
    "test:ui": "npm --prefix website run test:ui",
    "lint": "npm --prefix website run lint"
  }
}
