# Copy to .env and load it before starting Django. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.e2b.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.e2b.app
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Local development defaults to SQLite. For PostgreSQL, set DB_ENGINE and the values below.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=kairo_beats
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Paystack secret is server-side only. Without it, DEBUG mode uses demo orders.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
PAYSTACK_MOMO_CHANNELS=mobile_money
PAYSTACK_BANK_CHANNELS=bank,bank_transfer,card
PAYMENTS_DEMO_MODE=true

# Leave blank to print messages to the Django console in development.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=KAIRO Beats <hello@kairobeats.studio>
ADMIN_NOTIFICATION_EMAIL=
