# ── StreetMeet backend - LOCAL DEVELOPMENT ─────────────────────────────────
# Copy to .env and adjust. .env is git-ignored; .env.example is the template.

NODE_ENV=development
PORT=5000

# Database provider: "sqlite" (zero-setup dev) or "postgresql" (production).
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# PostgreSQL example (provider=postgresql):
# DATABASE_URL=postgresql://postgres:1983@localhost:5433/streetmeet

# Auth
JWT_SECRET=dev-only-streetmeet-secret-change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Public web client (used for CORS)
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_MAX_MB=5
PUBLIC_UPLOAD_URL=/uploads

# SQLite only: apply pending migrations on boot (always false for postgresql
# unless you explicitly set AUTO_MIGRATE=true)
AUTO_MIGRATE=true
