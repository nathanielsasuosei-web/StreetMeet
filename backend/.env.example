# ---------------------------------------------------------------------------
#  natthesisa API - environment variables
#  Copy to .env  ->  cp .env.example .env     (NEVER commit .env)
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Postgres connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@host:5432/natthesisa?sslmode=require"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# URLs (comma separated, no trailing slash)
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Media uploads: local | s3  (use s3/Cloudinary in production)
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# ------------------------------- Mobile money -------------------------------
# mock    = fake provider for local development (no real money, no keys needed)
# hubtel  = Hubtel Ghana (MTN MoMo, Vodafone Cash, AirtelTigo Money)
# paystack= Paystack Ghana (MTN MoMo, Vodafone Cash, AirtelTigo Money)
MOMO_PROVIDER=mock
MOMO_CURRENCY=GHS

# Hubtel (https://unity.hubtel.com -> API accounts). Basic auth = base64(ClientID:ClientSecret)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_WEBHOOK_TOKEN=

# Paystack (https://dashboard.paystack.com -> Settings -> API keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ------------------------------- WebRTC / calls ------------------------------
# Comma separated STUN/TURN servers. Add a TURN server for reliable calls
# (e.g. Cloudflare Calls, Twilio, Metered, coturn on your VPS)
TURN_URLS=stun:stun.l.google.com:19302
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------- Admin bootstrap -----------------------------
ADMIN_EMAIL=admin@natthesisa.com
ADMIN_PASSWORD=ChangeMe123!
