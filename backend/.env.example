# ── StreetMeet backend environment template ────────────────────────────────
# cp .env.example .env

NODE_ENV=development
PORT=5000

# "sqlite" for local development (no server needed, file based)
# "postgresql" for staging / production
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# ── PostgreSQL (production) ────────────────────────────────────────────────
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/streetmeet
# DATABASE_SSL=false

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# ── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=5
# Absolute CDN URL in production, e.g. https://cdn.streetmeet.com
PUBLIC_UPLOAD_URL=/uploads

# ── Subscriptions (Paystack) ───────────────────────────────────────────────
# Leave PAYSTACK_SECRET_KEY empty for mock mode (offline dev/demo: the API
# simulates initialize/verify and /api/billing/mock-pay approves charges).
# Set sk_test_… or sk_live_… to talk to the real Paystack.
PAYSTACK_SECRET_KEY=
# Optional dedicated webhook HMAC secret (defaults to the secret key above)
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=GHS
# Free-plan like budget per UTC day
BILLING_FREE_LIKE_LIMIT=20
# Where Paystack sends customers after payment (defaults to CLIENT_URL/premium)
# PAYSTACK_CALLBACK_URL=https://app.streetmeet.com/premium

# ── Migrations ─────────────────────────────────────────────────────────────
# SQLite dev convenience. For PostgreSQL run `npm run db:migrate` explicitly.
AUTO_MIGRATE=true
