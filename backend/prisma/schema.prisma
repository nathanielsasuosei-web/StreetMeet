generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  password      String
  phoneNumber   String?  @unique
  gender        Gender
  bio           String?
  city          String?
  birthDate     DateTime?
  profileImage  String?
  interests     String[]
  verified      Boolean @default(false)

  likesSent       Like[]    @relation("SentLikes")
  likesReceived   Like[]    @relation("ReceivedLikes")

  matchesOne      Match[]   @relation("UserOneMatches")
  matchesTwo      Match[]   @relation("UserTwoMatches")

  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  statuses        Status[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id          String   @id @default(cuid())

  senderId    String
  receiverId  String

  sender User @relation("SentLikes", fields: [senderId], references: [id])
  receiver User @relation("ReceivedLikes", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
}

model Match {
  id String @id @default(cuid())

  userOneId String
  userTwoId String

  userOne User @relation("UserOneMatches", fields: [userOneId], references: [id])
  userTwo User @relation("UserTwoMatches", fields: [userTwoId], references: [id])

  createdAt DateTime @default(now())
}

model Message {
  id String @id @default(cuid())

  senderId String
  receiverId String

  content String
  seen Boolean @default(false)

  sender User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
}

model Status {
  id String @id @default(cuid())

  userId String

  text String?
  mediaUrl String?
  mediaType String?
  views Int @default(0)

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}enum SubscriptionPlan {
  DAILY
  WEEKLY
  MONTHLY
  PREMIUM_PLUS
}


model Subscription {

  id String @id @default(cuid())

  userId String

  plan SubscriptionPlan

  amount Float

  paymentReference String @unique

  active Boolean @default(false)

  expiresAt DateTime

  user User @relation(
    fields:[userId],
    references:[id]
  )

  createdAt DateTime @default(now())

}enum Role {
  USER
  ADMIN
  MODERATOR
}model User {

  id String @id @default(cuid())

  fullName String
  email String @unique
  password String

  role Role @default(USER)

  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}model Report {

  id String @id @default(cuid())

  reporterId String
  reportedUserId String

  reason String

  status String @default("OPEN")

  createdAt DateTime @default(now())

}model Block {

id String @id @default(cuid())

blockerId String

blockedUserId String

createdAt DateTime @default(now())

}